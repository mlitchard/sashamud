{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/reload-rules.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/reload-workflow-rules-1.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/reload-workflow-rules-2.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/reload-workflow-rules-3.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/refuse-lookups.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/refuse-outside-reads.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/refuse-main-haskell-writes.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|Agent|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/refuse-after-rejection.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/require-agent-guards.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/refuse-web.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/mlitchard/gitlab/sashamud/.claude/hooks/mark-rejection.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
